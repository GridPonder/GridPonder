      }
    },
    {
      "id": "individual_movement",
      "type": "individual_actors",
      "enabled": false,
      "config": {
        "actorLayer": "actors",
        "groundLayer": "ground",
        "budgets": { "actor_a": 6, "actor_b": 6 },
        "claim": {
          "layer": "territory",
          "map": { "actor_a": "territory_a", "actor_b": "territory_b" }
        }
      }
    }
  ],
  "rules": [],
  "defaults": {
    "avatar": { "enabled": false },
    "maxCascadeDepth": 1
  },
