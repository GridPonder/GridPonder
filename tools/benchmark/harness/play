#!/usr/bin/env python3
"""The agent's entire interface to the puzzle.

Stateless: the supervisor on the other end of the socket owns the game. Copied
into the sandbox as the only executable there. Stdlib only, and no imports from
the benchmark package, because the sandbox contains no other Python files.

Exit codes: 0 ok, 2 usage/transport error, 3 run is over.
"""
import json
import os
import socket
import sys

SOCK_NAME = ".play.sock"


def main() -> int:
    argv = sys.argv[1:]
    if not argv:
        print("usage: ./play state | move '<json>' | history | give_up")
        return 2

    sock_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), SOCK_NAME)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(sock_path)
    except OSError:
        print("The puzzle server is not running. Nothing more can be done.",
              file=sys.stderr)
        return 2

    with sock:
        sock.sendall((json.dumps(argv) + "\n").encode("utf-8"))
        chunks = []
        while not chunks or not chunks[-1].endswith(b"\n"):
            chunk = sock.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)

    raw = b"".join(chunks).strip()
    if not raw:
        print("No response from the puzzle server.", file=sys.stderr)
        return 2

    payload = json.loads(raw.decode("utf-8"))
    print(payload.get("text", ""))
    return 3 if payload.get("terminal") else 0


if __name__ == "__main__":
    sys.exit(main())
